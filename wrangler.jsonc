{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "listen-cx",
  "main": "src/worker.ts",
  "account_id": "a353a278b3ec25248a6b5426d7fd1775",
  "compatibility_date": "2026-07-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "listen.cx/*",
      "zone_name": "listen.cx"
    }
  ],
  "vars": {
    "BASE_URL": "https://listen.cx",
    "THREAD_MAX_THREADS": 10000
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "listen-cx-production",
      "database_id": "641a57b8-aa04-445f-af5b-8f25bfc0c892",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "THREAD_CREATE_RATE_LIMITER",
      "namespace_id": "713001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "THREAD_CONTRIBUTION_RATE_LIMITER",
      "namespace_id": "713002",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "env": {
    "staging": {
      "name": "listen-cx-staging",
      "routes": [
        {
          "pattern": "staging.listen.cx",
          "custom_domain": true
        }
      ],
      "vars": {
        "BASE_URL": "https://staging.listen.cx",
        "THREAD_MAX_THREADS": 10000
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "listen-cx-staging",
          "database_id": "5c6403f5-eaa3-4dc2-befe-9b0bd8da4b9e",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        {
          "name": "THREAD_CREATE_RATE_LIMITER",
          "namespace_id": "713101",
          "simple": {
            "limit": 10,
            "period": 60
          }
        },
        {
          "name": "THREAD_CONTRIBUTION_RATE_LIMITER",
          "namespace_id": "713102",
          "simple": {
            "limit": 30,
            "period": 60
          }
        }
      ]
    }
  }
}
